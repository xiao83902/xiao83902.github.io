{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hkg1"],
  "functions": {
    "api/pcc-proxy.js": {
      "regions": ["hkg1"],
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/pcc/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/pcc/"
        }
      ]
    },
    {
      "source": "/pcc/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/hotel-parking-fee/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pcc",
      "destination": "/pcc/",
      "permanent": false
    },
    {
      "source": "/monthly-fee-manager",
      "destination": "/monthly-fee-manager/",
      "permanent": false
    },
    {
      "source": "/stock",
      "destination": "/stock/",
      "permanent": false
    },
    {
      "source": "/1credit",
      "destination": "/1credit/",
      "permanent": false
    },
    {
      "source": "/1Credit",
      "destination": "/1credit/",
      "permanent": false
    },
    {
      "source": "/1Credit/:path*",
      "destination": "/1credit/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/pcc/manifest.webmanifest",
      "destination": "/pcc-static/manifest.webmanifest"
    },
    {
      "source": "/pcc/sw.js",
      "destination": "/pcc-static/sw.js"
    },
    {
      "source": "/pcc/pcc-overrides.css",
      "destination": "/pcc-static/pcc-overrides.css"
    },
    {
      "source": "/pcc/pcc-enhancements.js",
      "destination": "/pcc-static/pcc-enhancements.js"
    },
    {
      "source": "/pcc/pcc-history.js",
      "destination": "/pcc-static/pcc-history.js"
    },
    {
      "source": "/pcc/history.html",
      "destination": "/pcc-static/history.html"
    },
    {
      "source": "/pcc/view.html",
      "destination": "/pcc-static/view.html"
    },
    {
      "source": "/pcc/pcc-view.js",
      "destination": "/pcc-static/pcc-view.js"
    },
    {
      "source": "/pcc/icon.svg",
      "destination": "/pcc-static/icon.svg"
    },
    {
      "source": "/pcc/favicon.png",
      "destination": "/pcc-static/favicon.png"
    },
    {
      "source": "/pcc/apple-touch-icon.png",
      "destination": "/pcc-static/apple-touch-icon.png"
    },
    {
      "source": "/pcc/icon-192.png",
      "destination": "/pcc-static/icon-192.png"
    },
    {
      "source": "/pcc/icon-512.png",
      "destination": "/pcc-static/icon-512.png"
    },
    {
      "source": "/pcc/api/:path*",
      "destination": "http://pcc.nas220.i234.me/api/:path*"
    },
    {
      "source": "/pcc/healthz",
      "destination": "http://pcc.nas220.i234.me/healthz"
    },
    {
      "source": "/pcc/",
      "destination": "/api/pcc-proxy?path="
    },
    {
      "source": "/pcc/:path*",
      "destination": "/api/pcc-proxy?path=:path*"
    },
    {
      "source": "/bankloan",
      "destination": "https://bank-loan-auto-calculation-system-pxr2m3v3na-de.a.run.app/"
    },
    {
      "source": "/bankloan/",
      "destination": "https://bank-loan-auto-calculation-system-pxr2m3v3na-de.a.run.app/"
    },
    {
      "source": "/bankloan/:path*",
      "destination": "https://bank-loan-auto-calculation-system-pxr2m3v3na-de.a.run.app/:path*"
    },
    {
      "source": "/bankcode",
      "destination": "https://bankcode-zeta.vercel.app/"
    },
    {
      "source": "/bankcode/",
      "destination": "https://bankcode-zeta.vercel.app/"
    },
    {
      "source": "/bankcode/:path*",
      "destination": "https://bankcode-zeta.vercel.app/:path*"
    },
    {
      "source": "/monthly-fee-manager/",
      "destination": "https://monthly-fee-manager.vercel.app/"
    },
    {
      "source": "/monthly-fee-manager/:path*",
      "destination": "https://monthly-fee-manager.vercel.app/:path*"
    },
    {
      "source": "/stock/",
      "destination": "https://knas718.i234.me:5001/stock/"
    },
    {
      "source": "/stock/:path*",
      "destination": "https://knas718.i234.me:5001/stock/:path*"
    },
    {
      "source": "/1credit/",
      "destination": "https://knas718.i234.me:5001/1credit/"
    },
    {
      "source": "/1credit/:path*",
      "destination": "https://knas718.i234.me:5001/1credit/:path*"
    },
    {
      "source": "/hotel-parking-fee",
      "destination": "https://storage.googleapis.com/hotel-parking-fee-0902-one/index.html"
    },
    {
      "source": "/hotel-parking-fee/",
      "destination": "https://storage.googleapis.com/hotel-parking-fee-0902-one/index.html"
    },
    {
      "source": "/hotel-parking-fee/:path*",
      "destination": "https://storage.googleapis.com/hotel-parking-fee-0902-one/:path*"
    }
  ]
}
