    {
      "source": "/pcc/manifest.webmanifest",
      "destination": "/pcc-static/manifest.webmanifest"
    },
    {
      "source": "/pcc/sw.js",
      "destination": "/pcc-static/sw.js"
    },
    {
      "source": "/pcc/pcc-overrides.css",
      "destination": "/pcc-static/pcc-overrides.css"
    },
    {
      "source": "/pcc/pcc-enhancements.js",
      "destination": "/pcc-static/pcc-enhancements.js"
    },
    {
      "source": "/pcc/icon.svg",
      "destination": "/pcc-static/icon.svg"
    },
    {
      "source": "/pcc/api/:path*",
      "destination": "http://nas220.i234.me:55721/api/:path*"
    },
    {
      "source": "/pcc/healthz",
      "destination": "http://nas220.i234.me:55721/healthz"
    },
    {
      "source": "/pcc/",
      "destination": "/api/pcc-proxy?path="
    },
    {
      "source": "/pcc/:path*",
      "destination": "/api/pcc-proxy?path=:path*"
    },
    {
      "source": "/bankloan",
      "destination": "https://bank-loan-auto-calculation-system-pxr2m3v3na-de.a.run.app/"
    },
    {
      "source": "/bankloan/",
